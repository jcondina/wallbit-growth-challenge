# All values below are the defaults: a clean clone works with no .env at all.

# SQLite file, relative to the project root. Created by `npm run seed`.
DB_PATH=var/wallbit.db

# Sandbox secret from simulator/PROVIDER.md, used to verify X-Wallbit-Signature.
WEBHOOK_SECRET=whsec_sandbox_wallbit

# Set to "false" only to accept unsigned deliveries (e.g. simulator --no-signature).
WEBHOOK_VERIFY_SIGNATURE=true
